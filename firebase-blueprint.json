{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Owner profile, identity, security credentials and global AI assistant settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerNickname": { "type": "string" },
        "ownerPhone": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerPinHash": { "type": "string" },
        "securityPhrase": { "type": "string" },
        "relationshipMode": { "type": "string" },
        "speakingStyle": { "type": "string" },
        "responseLength": { "type": "string" },
        "emojiLevel": { "type": "string" },
        "language": { "type": "string" },
        "activeVoiceProfileId": { "type": "string" },
        "activeEmotion": { "type": "string" },
        "wakeWordEnabled": { "type": "boolean" },
        "handsFreeEnabled": { "type": "boolean" },
        "autoEmotionEnabled": { "type": "boolean" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["userId", "ownerName"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Personalized long-term or private memory stored by MYRA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "content", "category"]
    },
    "VoiceProfile": {
      "title": "VoiceProfile",
      "description": "Custom or owner voice configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "voiceProvider": { "type": "string" },
        "voiceId": { "type": "string" },
        "language": { "type": "string" },
        "gender": { "type": "string" },
        "pitch": { "type": "number" },
        "speed": { "type": "number" },
        "volume": { "type": "number" },
        "emotionStyle": { "type": "string" },
        "personality": { "type": "string" },
        "isOwnerVoice": { "type": "boolean" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "voiceId"]
    },
    "PrimeContact": {
      "title": "PrimeContact",
      "description": "VIP contact with custom greetings and relationship tags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "nickname": { "type": "string" },
        "relationship": { "type": "string" },
        "priority": { "type": "string" },
        "customGreeting": { "type": "string" },
        "voiceAliases": { "type": "string" },
        "isVip": { "type": "boolean" }
      },
      "required": ["id", "userId", "name", "phoneNumber"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Scheduled reminder or recurring task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "timeMillis": { "type": "number" },
        "timeDisplay": { "type": "string" },
        "recurringPattern": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "AutomationRule": {
      "title": "AutomationRule",
      "description": "Smart automation when a trigger happens",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "triggerType": { "type": "string" },
        "condition": { "type": "string" },
        "actionType": { "type": "string" },
        "actionPayload": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "triggerType", "actionType"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "Conversation chat thread metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "isTemporary": { "type": "boolean" }
      },
      "required": ["id", "userId", "title"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual chat message turn in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "emotion": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "conversationId", "userId", "role", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner profile settings and security metadata"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/Memory" },
      "description": "User long-term memory items"
    },
    "/users/{userId}/voiceProfiles/{voiceProfileId}": {
      "schema": { "$ref": "#/entities/VoiceProfile" },
      "description": "Custom and owner voice studio profiles"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/PrimeContact" },
      "description": "Prime and VIP contacts list"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "User scheduled reminders"
    },
    "/users/{userId}/automations/{automationId}": {
      "schema": { "$ref": "#/entities/AutomationRule" },
      "description": "Smart automation routines"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ConversationSession" },
      "description": "Conversation threads"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Turn messages within a conversation"
    }
  }
}
